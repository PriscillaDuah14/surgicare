              </span>
            </div>

            <div className="mt-5 h-3 overflow-hidden rounded-full bg-white/10">
              <div className="h-full w-full rounded-full bg-[#10a88b]" />
            </div>

            <p className="mt-5 text-sm leading-6 text-slate-300">
              Every operational requirement
              has been confirmed.
            </p>

            <button
              className={`mt-7 w-full rounded-xl py-4 font-bold transition ${
                deploying
                  ? "bg-[#10a88b] text-white"
                  : "bg-white text-[#10233c]"
              }`}
            >
              {deploying
                ? "✓ MISSION DEPLOYED"
                : "Deploy Mission →"}
            </button>

            {deploying && (
              <div className="mt-4 rounded-xl bg-white/10 p-4 text-sm text-[#9ff0d9]">
                Akua Sarfowaa has been added
                to the mission patient roster.
              </div>
            )}
          </div>
        </section>
      </div>
    </AppShell>
  );
}

