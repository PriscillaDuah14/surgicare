"use client";

import { useEffect, useMemo, useState } from "react";

/* ========================================
   AUTOMATED SURGICARE DEMO

   IMPORTANT:
   This page is presentation-only.
   It does NOT write to Supabase.
======================================== */

const STEP_MS = 4200;

type DemoStep =
  | "login"
  | "authenticating"
  | "dashboard"
  | "facility"
  | "analyzing"
  | "recommendation"
  | "mission"
  | "deploying"
  | "clinician_dashboard"
  | "scheduled"
  | "checked_in"
  | "cleared"
  | "in_progress"
  | "completed"
  | "followup"
  | "referral"
  | "finished";

const steps: DemoStep[] = [
  "login",
  "authenticating",
  "dashboard",
  "facility",
  "analyzing",
  "recommendation",
  "mission",
  "deploying",
  "clinician_dashboard",
  "scheduled",
  "checked_in",
  "cleared",
  "in_progress",
  "completed",
  "followup",
  "referral",
  "finished",
];

const captions: Record<DemoStep, string> = {
  login:
    "SurgiCare provides secure, role-based access for the care team.",

  authenticating:
    "Authenticating the coordinator and preparing the correct workspace.",

  dashboard:
    "The Control Tower provides a live overview of facilities, patients and surgical readiness.",

  facility:
    "Asunafo Vision Centre has one registered patient who is ready for surgery.",

  analyzing:
    "The Recommendation Engine analyzes patient volume and surgical readiness.",

  recommendation:
    "Asunafo South is identified as an outreach opportunity with a surgery-ready cataract patient.",

  mission:
    "Before deployment, the coordinator confirms seven operational readiness requirements.",

  deploying:
    "All readiness requirements are satisfied. The outreach mission can now be deployed.",

  clinician_dashboard:
    "The deployed mission is now visible to the clinical team, creating a direct handoff from coordination to care delivery.",

  scheduled:
    "Akua Sarfowaa enters Mission Operations as a scheduled cataract patient.",

  checked_in:
    "Akua arrives at the outreach mission and is checked in.",

  cleared:
    "Clinical clearance confirms that the patient can proceed to surgery.",

  in_progress:
    "The cataract procedure is now in progress.",

  completed:
    "The procedure is completed and SurgiCare continues tracking the patient beyond surgery.",

  followup:
    "Structured post-operative follow-ups keep the patient connected to care.",

  referral:
    "A Day 1 complication is detected and referral is recorded for escalation.",

  finished:
    "SurgiCare connects identification, outreach planning, surgery and follow-up in one continuous care pathway.",
};

export default function DemoPage() {
  const [started, setStarted] =
    useState(false);

  const [playing, setPlaying] =
    useState(false);

  const [stepIndex, setStepIndex] =
    useState(0);

  const step = steps[stepIndex];

  const progress =
    ((stepIndex + 1) / steps.length) *
    100;

  useEffect(() => {
    if (!started || !playing) {
      return;
    }

    if (stepIndex >= steps.length - 1) {
      setPlaying(false);
      return;
    }

    const timer = window.setTimeout(
      () => {
        setStepIndex((current) =>
          Math.min(
            current + 1,
            steps.length - 1
          )
        );
      },
      step === "authenticating" ||
        step === "analyzing" ||
        step === "deploying"
        ? 3000
        : STEP_MS
    );

    return () =>
      window.clearTimeout(timer);
  }, [started, playing, stepIndex, step]);

  function startDemo() {
    setStepIndex(0);
    setStarted(true);
    setPlaying(true);
  }

  function restartDemo() {
    setStepIndex(0);
    setPlaying(true);
  }

  function next() {
    setStepIndex((current) =>
      Math.min(
        current + 1,
        steps.length - 1
      )
    );
  }

  function previous() {
    setStepIndex((current) =>
      Math.max(current - 1, 0)
    );
  }

  if (!started) {
    return <StartScreen onStart={startDemo} />;
  }

  return (
    <main className="min-h-screen bg-[#f6faf8] text-[#10233c]">
      {/* PROGRESS */}

      <div className="fixed left-0 right-0 top-0 z-[70] h-1 bg-[#dce8e4]">
        <div
          className="h-full bg-[#087f6b] transition-all duration-700"
          style={{
            width: `${progress}%`,
          }}
        />
      </div>

      {/* DEMO BADGE */}

      <div className="fixed right-5 top-5 z-[80] rounded-full border border-[#b9ded3] bg-white/95 px-4 py-2 text-xs font-bold uppercase tracking-[0.12em] text-[#087f6b] shadow-sm backdrop-blur">
        ● Demo Simulation
      </div>

      <DemoScene step={step} />

      {/* NARRATION */}

      <div className="fixed bottom-0 left-0 right-0 z-[60] border-t border-[#dfe9e5] bg-white/95 shadow-[0_-10px_40px_rgba(15,35,50,0.08)] backdrop-blur">
        <div className="mx-auto flex max-w-7xl flex-col gap-4 px-5 py-4 md:flex-row md:items-center md:justify-between md:px-8">
          <div className="max-w-3xl">
            <div className="flex items-center gap-2">
              <span className="flex h-7 w-7 items-center justify-center rounded-full bg-[#e7f6f1] text-xs font-bold text-[#087f6b]">
                {stepIndex + 1}
              </span>

              <p className="text-xs font-bold uppercase tracking-[0.14em] text-[#087f6b]">
                Automated walkthrough
              </p>
            </div>

            <p className="mt-2 text-sm leading-6 text-[#52635d]">
              {captions[step]}
            </p>
          </div>

          <div className="flex shrink-0 flex-wrap gap-2">
            <button
              type="button"
              onClick={previous}
              disabled={stepIndex === 0}
              className="rounded-xl border border-[#dfe9e5] bg-white px-4 py-2 text-sm font-semibold disabled:opacity-30"
            >
              ←
            </button>

            <button
              type="button"
              onClick={() =>
                setPlaying((value) => !value)
              }
              className="rounded-xl border border-[#b9ded3] bg-[#eef9f5] px-5 py-2 text-sm font-semibold text-[#087f6b]"
            >
              {playing
                ? "Pause"
                : "Resume"}
            </button>

            {stepIndex <
            steps.length - 1 ? (
              <button
                type="button"
                onClick={next}
                className="rounded-xl bg-[#087f6b] px-5 py-2 text-sm font-semibold text-white"
              >
                Next →
              </button>
            ) : (
              <button
                type="button"
                onClick={restartDemo}
                className="rounded-xl bg-[#087f6b] px-5 py-2 text-sm font-semibold text-white"
              >
                Restart
              </button>
            )}
          </div>
        </div>
      </div>
    </main>
  );
}

/* ========================================
   SCENE ROUTER
======================================== */

function DemoScene({
  step,
}: {
  step: DemoStep;
}) {
  if (
    step === "login" ||
    step === "authenticating"
  ) {
    return <LoginScene step={step} />;
  }

  if (
    step === "dashboard" ||
    step === "facility"
  ) {
    return (
      <DashboardScene step={step} />
    );
  }

  if (
    step === "analyzing" ||
    step === "recommendation"
  ) {
    return (
      <RecommendationScene step={step} />
    );
  }

  if (
    step === "mission" ||
    step === "deploying"
  ) {
    return <MissionScene step={step} />;
  }

  if (step === "clinician_dashboard") {
    return <ClinicianDashboardScene />;
  }

  if (
    step === "scheduled" ||
    step === "checked_in" ||
    step === "cleared" ||
    step === "in_progress" ||
    step === "completed" ||
    step === "followup" ||
    step === "referral"
  ) {
    return (
      <OperationsScene step={step} />
    );
  }

  return <FinishedScene />;
}

