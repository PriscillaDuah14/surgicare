                  </div>
                )
              )}
            </div>
          </div>
        </section>

        <section className="flex items-center">
          <div className="w-full rounded-3xl bg-[#10233c] p-8 text-white shadow-xl">
            <p className="text-xs font-bold uppercase tracking-[0.16em] text-[#9fc9bf]">
