/* ========================================
   OPERATIONS
======================================== */

function OperationsScene({
  step,
}: {
  step: DemoStep;
}) {
  const state = useMemo(() => {
    switch (step) {
      case "checked_in":
        return {
          status: "Checked In",
          action: "Clear for Procedure",
          completed: false,
        };

      case "cleared":
        return {
          status: "Cleared",
          action: "Start Procedure",
          completed: false,
        };

      case "in_progress":
        return {
          status: "In Procedure",
          action: "Complete Procedure",
          completed: false,
        };

      case "completed":
      case "followup":
      case "referral":
        return {
          status: "Completed",
          action: null,
          completed: true,
        };

      default:
        return {
          status: "Scheduled",
          action: "Check In",
          completed: false,
        };
    }
  }, [step]);

  const checkedIn =
    step !== "scheduled";

  const inProcedure =
    step === "in_progress";

  const showFollowup =
    step === "followup" ||
    step === "referral";

  const referral =
    step === "referral";

  return (
    <AppShell
      subtitle="Mission Operations"
      user="Clinical Team"
      role="clinician"
    >
      <div>
        <p className="text-xs font-bold uppercase tracking-[0.14em] text-[#087f6b]">
          Active outreach mission
        </p>

        <h2 className="mt-2 text-3xl font-bold">
          Asunafo South Outreach Cluster
          Mission
        </h2>

        <p className="mt-2 text-sm text-[#65756f]">
          Asunafo Vision Centre
        </p>
      </div>

      <section className="mt-7 grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
        <Metric label="Scheduled" value="1" />

        <Metric
          label="Checked In"
          value={checkedIn ? "1" : "0"}
        />

        <Metric
          label="In Procedure"
          value={inProcedure ? "1" : "0"}
        />

        <Metric
          label="Completed"
          value={
            state.completed ? "1" : "0"
          }
          green={state.completed}
        />

        <Metric label="No-show" value="0" />
      </section>

      <section className="mt-8">
        <p className="text-xs font-bold uppercase tracking-[0.14em] text-[#087f6b]">
          Live operations
        </p>

        <h2 className="mt-1 text-2xl font-bold">
          Patient Roster
        </h2>

        <article className="mt-5 rounded-3xl border border-[#dfe9e5] bg-white p-6 shadow-sm">
          <div className="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between">
            <div className="min-w-0 flex-1">
              <div className="flex flex-wrap items-center gap-3">
                <h3 className="text-xl font-bold">
                  Akua Sarfowaa
                </h3>

                <StatusPill
                  status={state.status}
                />
              </div>

              <p className="mt-2 text-sm font-medium text-[#087f6b]">
                Asunafo Vision Centre
              </p>

              <div className="mt-4 flex flex-wrap gap-x-7 gap-y-2 text-sm text-[#65756f]">
                <span>
                  <strong className="text-[#10233c]">
                    Procedure:
                  </strong>{" "}
                  Cataract
                </span>

                <span>
                  <strong className="text-[#10233c]">
                    Eye:
                  </strong>{" "}
                  Right Eye
                </span>

                <span>
                  <strong className="text-[#10233c]">
                    Age:
                  </strong>{" "}
                  45
                </span>
              </div>

              {state.completed && (
                <div className="mt-5 rounded-xl bg-[#eef9f5] p-4 text-sm font-medium text-[#08705f]">
                  ✓ Procedure completed
                  successfully. Post-operative
                  follow-up pathway activated.
                </div>
              )}

              {showFollowup && (
                <PostOp
                  referral={referral}
                />
              )}
            </div>

            <div className="shrink-0 lg:w-60">
              {state.action && (
                <button
                  className={`w-full rounded-xl px-5 py-3 text-sm font-semibold text-white shadow-sm ${
                    inProcedure
                      ? "bg-[#10233c]"
                      : "bg-[#087f6b]"
                  }`}
                >
                  {state.action}
                </button>
              )}

              {step === "checked_in" && (
                <p className="mt-3 text-center text-xs font-semibold text-[#087f6b]">
                  ✓ Patient checked in
                </p>
              )}

              {step === "cleared" && (
                <p className="mt-3 text-center text-xs font-semibold text-[#087f6b]">
                  ✓ Clinical clearance
                  complete
                </p>
              )}

              {step === "in_progress" && (
                <div className="mt-3 flex items-center justify-center gap-2 text-xs font-bold text-[#315b9a]">
                  <span className="h-2 w-2 animate-pulse rounded-full bg-[#315b9a]" />
                  PROCEDURE IN PROGRESS
                </div>
              )}
            </div>
          </div>
        </article>
      </section>
    </AppShell>
  );
}

/* ========================================
   POST OP
======================================== */

function PostOp({
  referral,
}: {
  referral: boolean;
}) {
  return (
    <div className="mt-6 border-t border-[#dfe9e5] pt-5">
      <p className="text-xs font-bold uppercase tracking-[0.14em] text-[#087f6b]">
        Post-Op Follow-Up
      </p>

      <div className="mt-4 space-y-3">
        <Followup
          title="Day 1"
          date="20 Sep 2026"
          status={
            referral ? "Referred" : "Due"
          }
          visualAcuity={
            referral ? "6/24" : "Pending"
          }
          alert={referral}
        />

        <Followup
          title="Week 1"
          date="26 Sep 2026"
          status="Due"
          visualAcuity="Pending"
        />

        <Followup
          title="Month 1"
          date="19 Oct 2026"
          status="Due"
          visualAcuity="Pending"
        />
      </div>

      {referral && (
        <div className="mt-5 rounded-2xl border border-amber-200 bg-amber-50 p-5">
          <div className="flex items-start gap-3">
            <span className="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-amber-100 text-lg">
              !
            </span>

            <div>
              <p className="font-bold text-amber-900">
                Clinical escalation
                required
              </p>

              <p className="mt-1 text-sm leading-6 text-amber-800">
                Day 1 visual acuity:
                <strong> 6/24</strong>.
                Complication recorded and
                referral required.
              </p>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}

/* ========================================
   FINISH
======================================== */

function FinishedScene() {
  const journey = [
    "Facility",
    "Patient",
    "Recommendation",
    "Mission",
    "Surgery",
    "Follow-up",
    "Referral",
  ];

  return (
    <div className="flex min-h-screen items-center justify-center bg-[#071a25] px-6 pb-28 text-white">
      <div className="w-full max-w-6xl text-center">
        <Logo large />

        <p className="mt-7 text-sm font-bold uppercase tracking-[0.25em] text-[#55d6bb]">
          Complete care loop
        </p>

        <h1 className="mx-auto mt-5 max-w-4xl text-5xl font-bold tracking-tight md:text-6xl">
          From identification to recovery.
        </h1>

        <p className="mx-auto mt-6 max-w-3xl text-lg leading-8 text-slate-300">
          SurgiCare connects fragmented
          outreach activities into one
          coordinated patient pathway.
        </p>

        <div className="mx-auto mt-10 flex max-w-5xl flex-wrap items-center justify-center gap-2">
          {journey.map((item, index) => (
            <div
              key={item}
              className="flex items-center gap-2"
            >
              <div className="rounded-xl border border-white/10 bg-white/10 px-4 py-3 text-sm font-semibold">
                ✓ {item}
              </div>

              {index <
                journey.length - 1 && (
                <span className="text-[#55d6bb]">
                  →
                </span>
              )}
            </div>
          ))}
        </div>

        <div className="mx-auto mt-10 max-w-3xl rounded-3xl border border-[#10a88b]/30 bg-[#10a88b]/10 p-6">
          <p className="text-sm font-semibold text-[#7ee6cf]">
            One connected system
          </p>

          <p className="mt-2 text-xl font-bold">
            Better coordination. Better
            continuity. Better outreach.
          </p>
        </div>
      </div>
    </div>
  );
}

/* ========================================
   SHELL
======================================== */

function AppShell({
  subtitle,
  user,
  role,
  children,
}: {
  subtitle: string;
  user: string;
  role: string;
  children: React.ReactNode;
}) {
  return (
    <div className="min-h-screen pb-32">
      <header className="border-b border-[#dfe9e5] bg-white">
        <div className="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 md:px-8">
          <div className="flex items-center gap-3">
            <Logo />

            <div>
              <h1 className="text-xl font-bold">
                SurgiCare
              </h1>

              <p className="text-xs font-medium text-[#087f6b]">
                {subtitle}
              </p>
            </div>
          </div>

          <div className="mr-40 hidden text-right sm:block">
            <p className="text-sm font-semibold">
              {user}
            </p>

            <p className="text-xs capitalize text-[#65756f]">
              {role}
            </p>
          </div>
        </div>
      </header>

      <div className="mx-auto max-w-7xl px-5 py-8 md:px-8">
        {children}
      </div>
    </div>
  );
}

/* ========================================
   SMALL COMPONENTS
======================================== */

function Logo({
  large = false,
}: {
  large?: boolean;
}) {
  return (
    <div
      className={`flex items-center justify-center rounded-2xl bg-[#087f6b] text-white ${
        large
          ? "mx-auto h-20 w-20"
          : "h-11 w-11"
      }`}
    >
      <svg
        viewBox="0 0 24 24"
        className={
          large
            ? "h-11 w-11"
            : "h-6 w-6"
        }
        fill="none"
        stroke="currentColor"
        strokeWidth="2"
      >
        <path
                  d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"
                />
                <circle cx="12" cy="12" r="2.5" />
      </svg>
    </div>
  );
}

function Metric({
  label,
  value,
  green = false,
}: {
  label: string;
  value: string;
  green?: boolean;
}) {
  return (
    <div
      className={`rounded-2xl border p-4 ${
        green
          ? "border-[#b9ded3] bg-[#eef9f5]"
          : "border-[#dfe9e5] bg-white"
      }`}
    >
      <p className="text-xs font-medium text-[#65756f]">
        {label}
      </p>

      <p
        className={`mt-2 text-2xl font-bold ${
          green
            ? "text-[#087f6b]"
            : "text-[#10233c]"
        }`}
      >
        {value}
      </p>
    </div>
  );
}

function SmallMetric({
  label,
  value,
  green = false,
}: {
  label: string;
  value: string;
  green?: boolean;
}) {
  return (
    <div
      className={`min-w-24 rounded-xl px-4 py-3 text-center ${
        green
          ? "bg-[#e7f6f1]"
          : "bg-[#f2f6f4]"
      }`}
    >
      <p className="text-xs text-[#65756f]">
        {label}
      </p>

      <p
        className={`mt-1 text-lg font-bold ${
          green
            ? "text-[#087f6b]"
            : ""
        }`}
      >
        {value}
      </p>
    </div>
  );
}

function Score({
  value,
  title,
}: {
  value: string;
  title: string;
}) {
  return (
    <div className="rounded-2xl bg-[#f6faf8] p-5">
      <p className="text-3xl font-bold text-[#087f6b]">
        {value}
      </p>

      <p className="mt-2 text-sm font-bold">
        {title}
      </p>
    </div>
  );
}

function StatusPill({
  status,
}: {
  status: string;
}) {
  const active =
    status === "Completed" ||
    status === "Cleared";

  return (
    <span
      className={`rounded-full px-3 py-1 text-xs font-bold ${
        active
          ? "bg-[#e7f6f1] text-[#087f6b]"
          : status === "In Procedure"
          ? "bg-[#e8f0ff] text-[#315b9a]"
          : "bg-[#eef2f8] text-[#40546d]"
      }`}
    >
      {status}
    </span>
  );
}

function Followup({
  title,
  date,
  status,
  visualAcuity,
  alert = false,
}: {
  title: string;
  date: string;
  status: string;
  visualAcuity: string;
  alert?: boolean;
}) {
  return (
    <div
      className={`grid gap-3 rounded-xl border p-4 sm:grid-cols-4 sm:items-center ${
        alert
          ? "border-amber-200 bg-amber-50"
          : "border-[#dfe9e5] bg-[#f9fbfa]"
      }`}
    >
      <div>
        <p className="text-xs text-[#65756f]">
          Follow-up
        </p>
        <p className="font-bold">
          {title}
        </p>
      </div>

      <div>
        <p className="text-xs text-[#65756f]">
          Scheduled
        </p>
        <p className="text-sm font-semibold">
          {date}
        </p>
      </div>

      <div>
        <p className="text-xs text-[#65756f]">
          Visual acuity
        </p>
        <p className="text-sm font-semibold">
          {visualAcuity}
        </p>
      </div>

      <div>
        <span
          className={`rounded-full px-3 py-1 text-xs font-bold ${
            alert
              ? "bg-amber-100 text-amber-800"
              : "bg-[#eef2f8] text-[#52635d]"
          }`}
        >
          {status}
        </span>
      </div>
    </div>
  );
}

function DemoInput({
  label,
  value,
}: {
  label: string;
  value: string;
}) {
  return (
    <div>
      <label className="mb-2 block text-sm font-semibold">
        {label}
      </label>

      <div className="rounded-xl border border-[#dfe9e5] bg-[#fbfdfc] px-4 py-3.5 text-sm text-[#52635d]">
        {value}
      </div>
    </div>
  );
}

function Spinner({
  large = false,
}: {
  large?: boolean;
}) {
  return (
    <span
      className={`inline-block animate-spin rounded-full border-[#cce9df] border-t-[#087f6b] ${
        large
          ? "h-12 w-12 border-4"
          : "h-5 w-5 border-2"
      }`}
    />
  );
}

function GoogleIcon() {
  return (
    <svg
      viewBox="0 0 24 24"
      className="h-5 w-5"
      aria-hidden="true"
    >
      <path
        fill="#4285F4"
        d="M21.6 12.23c0-.71-.06-1.4-.18-2.07H12v3.92h5.38a4.6 4.6 0 0 1-2 3.02v2.54h3.24c1.9-1.75 2.98-4.33 2.98-7.41z"
      />
      <path
        fill="#34A853"
        d="M12 22c2.7 0 4.97-.9 6.63-2.36l-3.24-2.54c-.9.6-2.05.96-3.39.96-2.61 0-4.82-1.76-5.61-4.13H3.04v2.62A10 10 0 0 0 12 22z"
      />
      <path
        fill="#FBBC05"
        d="M6.39 13.93A6 6 0 0 1 6.08 12c0-.67.11-1.32.31-1.93V7.45H3.04A10 10 0 0 0 2 12c0 1.61.38 3.13 1.04 4.55l3.35-2.62z"
      />
      <path
        fill="#EA4335"
        d="M12 5.94c1.47 0 2.79.5 3.83 1.49l2.87-2.87A9.65 9.65 0 0 0 12 2a10 10 0 0 0-8.96 5.45l3.35 2.62C7.18 7.7 9.39 5.94 12 5.94z"
      />
    </svg>
  );
}
