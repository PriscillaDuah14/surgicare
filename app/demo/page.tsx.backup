  onStart,
}: {
  onStart: () => void;
}) {
  return (
    <main className="relative flex min-h-screen items-center justify-center overflow-hidden bg-[#071a25] px-6 text-white">
      <div className="absolute -left-40 -top-40 h-[500px] w-[500px] rounded-full bg-[#087f6b]/20 blur-3xl" />

      <div className="absolute -bottom-52 -right-32 h-[600px] w-[600px] rounded-full bg-[#10a88b]/10 blur-3xl" />

      <div className="relative z-10 w-full max-w-5xl text-center">
        <Logo large />

        <p className="mt-8 text-sm font-bold uppercase tracking-[0.3em] text-[#55d6bb]">
          SurgiCare
        </p>

        <h1 className="mx-auto mt-5 max-w-4xl text-5xl font-bold tracking-tight md:text-7xl">
          One patient.
          <br />
          One connected care journey.
        </h1>

        <p className="mx-auto mt-7 max-w-2xl text-lg leading-8 text-slate-300">
          Watch SurgiCare automatically
          demonstrate the complete pathway
          from outreach intelligence to
          surgery and post-operative care.
